<section class="res-hero">
  <div class="container res-hero-grid">
    <div>
      <span class="res-kicker">Official declaration · Circular GVIS/EXAM/2025/11</span>
      <h1>CBSE Results 2024–25</h1>
      <p>Class X and XII · 100% pass · 41 students above 90%. Photographs and names are published with parent consent.</p>
      <div class="res-hero-meta">
        <span><i class="fa-solid fa-calendar"></i> Declared 13 May 2025</span>
        <span><i class="fa-solid fa-stamp"></i> CBSE, New Delhi</span>
        <span><i class="fa-solid fa-user-check"></i> Exam Cell, Gate 2</span>
      </div>
    </div>
    <aside class="res-hero-score">
      <em>School topper · Class XII</em>
      <strong>97.8%</strong>
      <p>Aarav Malhotra · Science</p>
    </aside>
  </div>
</section>

<section class="acad-page res-page">
  <div class="container">

    <div class="res-stats">
      <div><b>100%</b><span>Class X pass</span></div>
      <div><b>100%</b><span>Class XII pass</span></div>
      <div><b>82.6%</b><span>Class X average</span></div>
      <div><b>41</b><span>90% and above</span></div>
    </div>

    <div class="res-tabs" role="tablist">
      <button type="button" class="on" data-res="xii">Class XII</button>
      <button type="button" data-res="x">Class X</button>
      <button type="button" data-res="pride">Little wins wall</button>
    </div>

    <div class="res-panel on" data-panel="xii">
      <article class="res-feature">
        <img src="images/topper-aarav.jpg" alt="Aarav Malhotra">
        <div>
          <span class="res-rank gold">School topper</span>
          <h2>Aarav Malhotra</h2>
          <p class="res-stream">Class XII · Science · PCM</p>
          <p class="res-big">97.8%</p>
          <p>Mathematics 99 · Physics 97 · Chemistry 96 · English 96 · Computer Science 95. Offered seats at DTU and NSUT counselling rounds.</p>
        </div>
      </article>

      <h3>Stream toppers</h3>
      <div class="topper-grid">
        <article class="topper-card">
          <span class="res-rank gold">I</span>
          <img src="images/topper-aarav.jpg" alt="Aarav Malhotra">
          <div>
            <em>Science</em>
            <h4>Aarav Malhotra</h4>
            <b>97.8%</b>
            <p>Physics · Chemistry · Mathematics</p>
          </div>
        </article>
        <article class="topper-card">
          <span class="res-rank silver">I</span>
          <img src="images/topper-diya.jpg" alt="Diya Banerjee">
          <div>
            <em>Commerce</em>
            <h4>Diya Banerjee</h4>
            <b>96.4%</b>
            <p>Accountancy · B.St. · Economics</p>
          </div>
        </article>
        <article class="topper-card">
          <span class="res-rank bronze">I</span>
          <img src="images/topper-ishaan.jpg" alt="Ishaan Qureshi">
          <div>
            <em>Humanities</em>
            <h4>Ishaan Qureshi</h4>
            <b>95.2%</b>
            <p>History · Political Science · English</p>
          </div>
        </article>
      </div>
    </div>

    <div class="res-panel" data-panel="x">
      <h3>Class X · 118 appeared, all passed</h3>
      <p class="fee-note">School average 82.6%. Twenty-nine students scored 90% and above.</p>
      <div class="topper-grid two">
        <article class="topper-card">
          <span class="res-rank gold">I</span>
          <img src="images/topper-ananya.jpg" alt="Ananya Iyer">
          <div>
            <em>Class X · First</em>
            <h4>Ananya Iyer</h4>
            <b>97.2%</b>
            <p>Science 99 · English 96</p>
          </div>
        </article>
        <article class="topper-card">
          <span class="res-rank silver">II</span>
          <img src="images/topper-kabir.jpg" alt="Kabir Singh">
          <div>
            <em>Class X · Second</em>
            <h4>Kabir Singh</h4>
            <b>96.0%</b>
            <p>Social Science 98 · Mathematics 95</p>
          </div>
        </article>
      </div>
    </div>

    <div class="res-panel" data-panel="pride">
      <div class="pride-head">
        <h3>Little wins wall</h3>
        <p>Board ranks are one story. This wall is for the child who finished a race, sang first on stage, won a drawing meet, or helped a new classmate. Special children and CWSN students are named here with the same pride.</p>
      </div>
      <div class="pride-grid">
        <article class="pride-card">
          <img src="images/win-art.jpg" alt="Myra Sen">
          <div>
            <em>Art · IV-B</em>
            <h4>Myra Sen</h4>
            <p>Zonal drawing meet — first prize.</p>
          </div>
        </article>
        <article class="pride-card">
          <img src="images/win-sports.jpg" alt="Reyansh Gupta">
          <div>
            <em>Athletics · V-A</em>
            <h4>Reyansh Gupta</h4>
            <p>First medal — 100 m bronze, sports day.</p>
          </div>
        </article>
        <article class="pride-card">
          <img src="images/win-quiz.jpg" alt="Zoya Khan">
          <div>
            <em>Quiz · VII-A</em>
            <h4>Zoya Khan</h4>
            <p>Junior GK quiz, Green House.</p>
          </div>
        </article>
        <article class="pride-card">
          <img src="images/win-kind.jpg" alt="Ayaan Ali">
          <div>
            <em>Kindness · II-B</em>
            <h4>Ayaan Ali</h4>
            <p>Walked a new child through week one.</p>
          </div>
        </article>
        <article class="pride-card">
          <img src="images/win-music.jpg" alt="Kiara D’Souza">
          <div>
            <em>Music · III-A</em>
            <h4>Kiara D’Souza</h4>
            <p>First assembly solo. CWSN classroom.</p>
          </div>
        </article>
      </div>
      <div class="acad-band">
        <div>
          <h3>How a name is pinned</h3>
          <p>Class teachers send one note a week. House captains add clubs. The counsellor adds CWSN milestones.</p>
        </div>
        <div>
          <h3>Parents may write in</h3>
          <p>Email <strong>pride@greenvalley.edu.in</strong> with a photo and one line. We never publish without consent.</p>
        </div>
        <div>
          <h3>Next pin-up</h3>
          <p>Last Friday of the month, after assembly. Copied here the same evening.</p>
        </div>
      </div>
    </div>

    <div class="acad-split res-lower">
      <div>
        <h3>Subject distinctions · 2024–25</h3>
        <div class="table-scroll">
        <table class="info-table">
          <tr><th>Class</th><th>Subject</th><th>Highest</th><th>Student</th></tr>
          <tr><td>XII</td><td>Mathematics</td><td>99</td><td>Aarav Malhotra</td></tr>
          <tr><td>XII</td><td>Accountancy</td><td>98</td><td>Diya Banerjee</td></tr>
          <tr><td>XII</td><td>English</td><td>97</td><td>Ishaan Qureshi</td></tr>
          <tr><td>X</td><td>Science</td><td>99</td><td>Ananya Iyer</td></tr>
          <tr><td>X</td><td>Social Science</td><td>98</td><td>Kabir Singh</td></tr>
          <tr><td>X</td><td>Hindi</td><td>97</td><td>Meher Kapoor</td></tr>
        </table>
        </div>
        <h3>Five-year snapshot</h3>
        <div class="table-scroll">
        <table class="info-table">
          <tr><th>Session</th><th>X pass</th><th>XII pass</th><th>90% +</th></tr>
          <tr><td>2024–25</td><td>100%</td><td>100%</td><td>41</td></tr>
          <tr><td>2023–24</td><td>100%</td><td>100%</td><td>36</td></tr>
          <tr><td>2022–23</td><td>100%</td><td>99.2%</td><td>31</td></tr>
          <tr><td>2021–22</td><td>100%</td><td>100%</td><td>28</td></tr>
        </table>
        </div>
      </div>
      <aside class="story-side">
        <div class="side-card">
          <h3>Collect marksheets</h3>
          <div class="fact"><span>Where</span><strong>Academic Office, Gate 2</strong></div>
          <div class="fact"><span>When</span><strong>Mon–Sat, 9 AM – 1 PM</strong></div>
          <div class="fact"><span>Bring</span><strong>Parent ID used at admission</strong></div>
          <p>CBSE issues the official marksheet. School copies, migration (XII) and character certificates are given together. No courier. Duplicates take 7 working days.</p>
        </div>
        <div class="side-card">
          <h3>Exam cell</h3>
          <p>exam@greenvalley.edu.in<br>+91 98765 43210</p>
          <a class="text-link" href="news-midterm.html">Current exam notice →</a>
        </div>
      </aside>
    </div>
  </div>
</section>

